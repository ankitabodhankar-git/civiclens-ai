{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user with assigned civic role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Authentication UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "enum": ["citizen", "officer", "admin"], "description": "Access control role" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last profile update timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "CivicIssue": {
      "title": "CivicIssue",
      "description": "Citizen-reported civic problem enhanced with Gemini AI intelligence and governance tracking",
      "type": "object",
      "properties": {
        "issueId": { "type": "string", "description": "Unique issue document ID" },
        "ownerId": { "type": "string", "description": "UID of the citizen reporter" },
        "ownerEmail": { "type": "string", "description": "Masked or direct email of reporter" },
        "title": { "type": "string", "maxLength": 200, "description": "Structured issue title generated by AI or citizen" },
        "description": { "type": "string", "maxLength": 8000, "description": "Detailed citizen narrative" },
        "location": { "type": "string", "maxLength": 300, "description": "Physical or civic location reported" },
        "category": { "type": "string", "enum": ["Infrastructure", "Sanitation", "Transportation", "Environment", "Public Safety", "Public Health", "Education", "Other"] },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "urgency": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "impact": { "type": "string", "maxLength": 500, "description": "Who or what is affected" },
        "summary": { "type": "string", "maxLength": 1000, "description": "Factual summary of the issue" },
        "recommendedAction": { "type": "string", "maxLength": 1000, "description": "Practical suggested next steps" },
        "priorityScore": { "type": "number", "description": "Advisory AI Priority score 1-100" },
        "aiConfidence": { "type": "number", "description": "Model confidence metric 0.0-1.0" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] },
        "createdAt": { "type": "string", "description": "Timestamp when issue was recorded" },
        "updatedAt": { "type": "string", "description": "Timestamp of last modification" },
        "resolvedAt": { "type": "string", "description": "Timestamp when issue was resolved" },
        "aiAnalyzedAt": { "type": "string", "description": "Timestamp of AI analysis" },
        "isDemo": { "type": "boolean", "description": "Flag to mark pre-seeded sample data" },
        "slaTargetAt": { "type": "string", "description": "Advisory target SLA resolution deadline timestamp" },
        "slaStatus": { "type": "string", "enum": ["On Track", "At Risk", "Overdue", "Resolved"], "description": "Current status against advisory SLA" },
        "relatedIssueIds": { "type": "array", "description": "IDs of nearby or recurring issues detected in vicinity" }
      },
      "required": ["issueId", "ownerId", "description", "location", "title", "category", "severity", "urgency", "priorityScore", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable governance audit record for administrative and status actions",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "description": "Unique audit log identifier" },
        "actorId": { "type": "string", "description": "UID of the officer or admin performing the action" },
        "actorRole": { "type": "string", "description": "Role of the actor at action time" },
        "actorEmail": { "type": "string", "description": "Email address of the actor" },
        "action": { "type": "string", "description": "Type of action taken" },
        "issueId": { "type": "string", "description": "Related issue ID" },
        "previousStatus": { "type": "string", "description": "Status prior to change" },
        "newStatus": { "type": "string", "description": "Updated status" },
        "timestamp": { "type": "string", "description": "Server timestamp of audit log" },
        "notes": { "type": "string", "description": "Optional administrative remarks" }
      },
      "required": ["actorId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile with role-based access level"
    },
    "/issues/{issueId}": {
      "schema": { "$ref": "CivicIssue" },
      "description": "Master civic issues collection with historical data and status"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Historical audit log tracking all issue status modifications"
    }
  }
}
